# MINOVA Backend Configuration
# Copy to .env and adjust values

# App
APP_NAME=MINOVA
DEBUG=true
API_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# Database (PostgreSQL; sync URL is used by Alembic migrations)
DATABASE_URL=postgresql+asyncpg://minova_app:minova_dev@localhost:5433/minova
DATABASE_SYNC_URL=postgresql+psycopg2://minova_app:minova_dev@localhost:5433/minova
DB_ECHO=false
DB_POOL_SIZE=10

# Keycloak
KEYCLOAK_URL=http://localhost:8081
KEYCLOAK_REALM=minova
KEYCLOAK_CLIENT_ID=minova-api

# MinIO (S3-compatible)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false

# Local filesystem storage (fallback when object storage is unavailable)
STORAGE_ROOT=data/object-storage

# HuggingFace model cache directory
HF_HOME=data/models/huggingface

# Ollama LLM
OLLAMA_URL=http://localhost:11434
LLM_MODEL=qwen3:8b
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# Embeddings
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# Temporal
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=minova-main

# Weather
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Logging
LOG_LEVEL=INFO
LOG_JSON=false

# Business rules
CONFLICT_TOLERANCE_PCT=0.5
SLA_DEFAULT_HOURS=24
MINE_TIMEZONE=Asia/Kolkata
