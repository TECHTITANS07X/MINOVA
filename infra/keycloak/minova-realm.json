{
  "realm": "minova",
  "enabled": true,
  "displayName": "MINOVA Mining Platform",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 3600,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "offlineSessionIdleTimeout": 2592000,
  "accessCodeLifespan": 60,
  "roles": {
    "realm": [
      { "name": "admin", "description": "System administrator" },
      { "name": "auditor", "description": "Audit and compliance reviewer" },
      { "name": "corporate_viewer", "description": "Corporate-level read access (CIL/CMPDI)" },
      { "name": "cmd", "description": "Chairman & Managing Director" },
      { "name": "director", "description": "Director / Functional Director / Director of Mines" },
      { "name": "cgm", "description": "Chief General Manager" },
      { "name": "gm", "description": "General Manager" },
      { "name": "dgm", "description": "Deputy General Manager" },
      { "name": "cm", "description": "Chief Manager" },
      { "name": "acm", "description": "Assistant Chief Manager" },
      { "name": "dcm", "description": "Deputy Chief Manager" },
      { "name": "ee", "description": "Executive Engineer" },
      { "name": "ae", "description": "Assistant Engineer" },
      { "name": "executive_supervisor", "description": "Executive Supervisor (field oversight)" },
      { "name": "foreman", "description": "Foreman (field data entry)" },
      { "name": "worker", "description": "Worker (view only)" },
      { "name": "unit_head", "description": "Unit Head (mine-level approval)" },
      { "name": "assistant_manager", "description": "Assistant Manager (verification)" },
      { "name": "manager", "description": "Manager (verification)" },
      { "name": "supervisor", "description": "Supervisor (review)" },
      { "name": "engineer", "description": "Engineer (review)" }
    ]
  },
  "clients": [
    {
      "clientId": "minova-portal",
      "name": "MINOVA Management Portal",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "protocol": "openid-connect",
      "rootUrl": "http://localhost:5173",
      "baseUrl": "/",
      "redirectUris": [
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://127.0.0.1:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*"
      },
      "defaultClientScopes": ["openid", "profile", "email", "roles"],
      "optionalClientScopes": ["offline_access"]
    },
    {
      "clientId": "minova-mobile",
      "name": "MINOVA Field App",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "protocol": "openid-connect",
      "rootUrl": "",
      "redirectUris": [
        "com.minova.mobile://callback",
        "http://localhost:*",
        "http://127.0.0.1:*"
      ],
      "webOrigins": ["*"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": ["openid", "profile", "email", "roles"],
      "optionalClientScopes": ["offline_access"]
    },
    {
      "clientId": "minova-api",
      "name": "MINOVA Backend API",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "defaultClientScopes": ["openid", "profile", "email", "roles"]
    }
  ],
  "clientScopes": [
    {
      "name": "roles",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "username-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "realm-roles-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "multivalued": "true",
            "claim.name": "realm_roles",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "mine-attribute-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "mine",
            "claim.name": "mine",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "department-attribute-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "department",
            "claim.name": "department",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
