  "scopeMappings": [
    {
      "client": "minova-portal",
      "roles": ["admin", "auditor", "corporate_viewer", "cmd", "director", "cgm", "gm", "dgm", "cm", "acm", "dcm", "ee", "ae", "executive_supervisor", "foreman", "worker", "unit_head", "assistant_manager", "manager", "supervisor", "engineer"]
    },
    {
      "client": "minova-mobile",
      "roles": ["foreman", "executive_supervisor", "supervisor", "engineer", "ae", "ee", "worker"]
    }
  ],
  "browserSecurityHeaders": {
    "contentSecurityPolicy": "frame-src 'self'; frame-ancestors 'self'; object-src 'none';",
    "xContentTypeOptions": "nosniff",
    "xFrameOptions": "SAMEORIGIN",
    "xXSSProtection": "1; mode=block"
  }
